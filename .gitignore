# ============================================
# 全局排除：生成的数据/结果文件类型
# ============================================
*.tsv
*.log
*.pdb
*.cif
*.gz
*.a3m
*.fasta
*.fa
*.out
*.sc
*.mutfile
*.ddg
*.m8
*.pml
*.params
*.sample
*.trb

/**/model_params/**

# 结果/指标汇总（按需选择性恢复，见下方各项目区）
*.csv

# ============================================
# Python / Jupyter 缓存
# ============================================
__pycache__/
*.pyc
.ipynb_checkpoints/
.mypy_cache/



# ============================================
# alphafold3 — 恢复必要文件
# 保留：脚本、notebook、配置JSON、PDB列表
# ============================================
/alphafold3/predict/original_result/
/alphafold3/test/
!alphafold3/*.sh
!alphafold3/*.ipynb
!alphafold3/*.json
!alphafold3/*.list
!alphafold3/readme.md
!/alphafold3/predict_metrics/**/*.csv
!/alphafold3/predict_metrics/**/*.ipynb
!/alphafold3/predict_metrics/**/*.out


# ============================================
# ESMFold2 outputs
# ============================================
/esmfold2/test_output/
/esmfold2/PepSet_dimer/
/esmfold2/test*/
!/esmfold2/*.ipynb
!/esmfold2/*.sh
!/esmfold2/PepSet_dimer_output/**/*.json


# ============================================
# dataset — 排除所有处理后的PDB/噪声数据
# 保留：PDB列表、JSON清单、notebook
# ============================================
!/dataset/*.ipynb



# ============================================
# ligandmpnn — 排除生成的设计/评分数据
# 保留：脚本、notebook、配置
# ============================================
/ligandmpnn/**/model_params/
/ligandmpnn/check_filter/predict/
/ligandmpnn/test_filter/LigandMPNN-Output/
/ligandmpnn/test_filter/Protenix/
/ligandmpnn/test_hyperparam/PeptideMPNN_weight/
/ligandmpnn/test_weight/outputs/
/ligandmpnn/check_filter/LigandMPNN-Output-pred_dimer/*
/ligandmpnn/test_hyperparam/outputs/*

!/ligandmpnn/*.md
!/ligandmpnn/*.ipynb
!/ligandmpnn/*.py
!/ligandmpnn/*.sh
!/ligandmpnn/*.xml

# === LigandMPNN-Output-pred_dimer: 仅保留 csv 结果 ===
!/ligandmpnn/check_filter/LigandMPNN-Output-pred_dimer/**/
!/ligandmpnn/check_filter/LigandMPNN-Output-pred_dimer/**/*.csv

# === test_hyperparam/outputs: 仅保留 csv + 图片 ===
!/ligandmpnn/test_hyperparam/outputs/**/
!/ligandmpnn/test_hyperparam/outputs/**/*.csv
!/ligandmpnn/test_hyperparam/outputs/**/*.png


