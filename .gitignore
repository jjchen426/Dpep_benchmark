# ============================================
# 全局排除：生成的数据/结果文件类型
# ============================================
*.tsv
*.log
*.pdb
*.cif
*.gz
*.a3m
*.fasta
*.fa
*.out
*.sc
*.mutfile
*.ddg
*.m8
*.pml
*.params
*.sample
*.trb
*.db
*.h5

# ============================================
# model_params（软链接到模型权重）
# ============================================
**/model_params/

# ============================================
# 结果/指标汇总（按需选择性恢复，见下方各项目区）
# ============================================
*.csv

# ============================================
# Python / Jupyter 缓存
# ============================================
__pycache__/
*.pyc
.ipynb_checkpoints/
.mypy_cache/

# ============================================
# 01_structure_prediction
# ============================================
/01_structure_prediction/**/outputs/
/01_structure_prediction/**/test/
/01_structure_prediction/archive/oldpredict_summary/figures/
!/01_structure_prediction/summary/src/**/*.csv

# ============================================
# 02_ligandmpnn
# ============================================
/02_ligandmpnn/**/outputs/
/02_ligandmpnn/**/src/
/02_ligandmpnn/**/test/
/02_ligandmpnn/**/__pycache__/

# 恢复汇总结果
!/02_ligandmpnn/**/outputs/**/*.csv
!/02_ligandmpnn/**/outputs/**/*.png

# ============================================
# 04_RFdiffusion2 — 整体忽略，仅保留例外
# ============================================
/04_RFdiffusion2/*
!/04_RFdiffusion2/alanine-scan/
!/04_RFdiffusion2/alanine-scan/ddg_files/
!/04_RFdiffusion2/alanine-scan/ddg_files/**/job.list
!/04_RFdiffusion2/alanine-scan/ddg_plot/
!/04_RFdiffusion2/alanine-scan/ddg_plot/ddg_heatmap.tar.gz
# 重新忽略 alanine-scan 中的非例外内容
/04_RFdiffusion2/alanine-scan/*
!/04_RFdiffusion2/alanine-scan/ddg_files/
!/04_RFdiffusion2/alanine-scan/ddg_plot/
/04_RFdiffusion2/alanine-scan/ddg_files/**/*.ok
/04_RFdiffusion2/alanine-scan/ddg_plot/*.png

# ============================================
# dataset — 只保留 00_compressed + 脚本
# ============================================
/dataset/*
!/dataset/00_compressed/
!/dataset/00_compressed/**/*.gz
!/dataset/*.ipynb
!/dataset/*.py

# ============================================
# dataset_for_predict — 完全忽略
# ============================================
/dataset_for_predict/

# ============================================
# Rosetta — 完全忽略
# ============================================
/Rosetta/

