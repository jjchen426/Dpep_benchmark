   ],
   "source": [
    "\n",
    "pdbs = [pdb.split('.')[0] for pdb in sorted(os.listdir(\"/home/junjiechen/1_work/250401-Dpepalign/Benchmark/alphafold3/PepSet_AF3_pass\")) if pdb.endswith('.pdb')]\n",
    "\n",
    "pdbparser = PDBParser(QUIET=True)\n",
    "mmcifparser = FastMMCIFParser(QUIET=True)\n",
    "\n",
    "rows = []\n",
    "for pdb in pdbs:\n",
    "\n",
    "    output_root = \"/home/junjiechen/1_work/250401-Dpepalign/Benchmark/Rosetta/interface/AF3/predict/outputs\"\n",
    "    ref_pdb_path = f\"/home/junjiechen/1_work/250401-Dpepalign/Benchmark/alphafold3/PepSet_AF3_pass/{pdb}.pdb\"\n",
    "\n",
    "    if not os.path.exists(ref_pdb_path):\n",
    "        raise FileNotFoundError(f\"Reference PDB file not found: {ref_pdb_path}\")\n",
    "\n",
    "    predicted_pdb_dirs = sorted([\n",
    "        os.path.join(output_root, d)\n",
    "        for d in os.listdir(output_root)\n",
    "        if d.startswith(pdb) and os.path.isdir(os.path.join(output_root, d))\n",
    "    ])\n",
    "\n",
    "    if not predicted_pdb_dirs:\n",
    "        continue\n",
    "\n",
    "    structure_ref = pdbparser.get_structure('ref', ref_pdb_path)\n",
    "    chain_L_ref = structure_ref[0]['B']\n",
    "\n",
    "    for predicted_pdb_dir in sorted(predicted_pdb_dirs):\n",
    "        complex_name = os.path.basename(predicted_pdb_dir)\n",
    "        # print(f\"Processing complex: {complex_name}\")\n",
    "        \n",
    "        sample_dirs = [\n",
    "            d for d in os.listdir(predicted_pdb_dir)\n",
    "            if d.startswith('seed-') and '_sample-' in d and os.path.isdir(os.path.join(predicted_pdb_dir, d))\n",
    "        ]\n",
    "\n",
    "        sample_dirs = [d for d in sample_dirs \n",
    "                       if any(seed in d for seed in ['seed-42', 'seed-43', 'seed-44', 'seed-45', 'seed-46'])]  # 格式为seed-42_sample-0\n",
    "\n",
    "        for sample in sorted(sample_dirs):\n",
    "            sample_dir = os.path.join(predicted_pdb_dir, sample)\n",
    "            print(f\"Processing sample: {sample} in complex: {complex_name}\")\n",
    "\n",
    "            seed_str, sample_str = sample.split('_sample-')\n",
    "            seed = int(seed_str.replace('seed-', ''))\n",
    "            sample_id = int(sample_str)\n",
    "\n",
    "            conf_json_path = os.path.join(sample_dir, f\"{complex_name}_{sample}_confidences.json\")\n",
    "            summary_json_path = os.path.join(sample_dir, f\"{complex_name}_{sample}_summary_confidences.json\")\n",
    "            cif_path = os.path.join(sample_dir, f\"{complex_name}_{sample}_model.cif\")\n",
    "            \n",
    "            if not (os.path.exists(conf_json_path) and os.path.exists(summary_json_path) and os.path.exists(cif_path)):\n",
    "                raise FileNotFoundError(f\"Required files not found for sample: {sample} in complex: {complex_name}\")\n",
    "\n",
    "\n",
    "\n",
    "            with open(conf_json_path, 'r') as f_json:\n",
    "                conf_data = json.load(f_json)\n",
    "            atom_chain_ids = conf_data.get('atom_chain_ids', [])\n",
    "            atom_plddts = conf_data.get('atom_plddts', [])\n",
    "            if len(atom_chain_ids) == 0 or len(atom_chain_ids) != len(atom_plddts):\n",
    "                raise ValueError(f\"Invalid data in sample: {sample} of complex: {complex_name}\")\n",
    "\n",
    "            b_chain_plddt = [\n",
    "                float(plddt)\n",
    "                for chain_id, plddt in zip(atom_chain_ids, atom_plddts)\n",
    "                if chain_id == 'B'\n",
    "            ]\n",
    "            if len(b_chain_plddt) == 0:\n",
    "                raise ValueError(f\"No valid Plddt values found for chain B in sample: {sample} of complex: {complex_name}\")\n",
    "            pep_plddt = round(float(np.mean(b_chain_plddt)), 4)\n",
    "\n",
    "            with open(summary_json_path, 'r') as f_json:\n",
    "                summary_data = json.load(f_json)\n",
    "            if 'iptm' not in summary_data or 'ranking_score' not in summary_data:\n",
    "                raise ValueError(f\"Required fields not found in summary data for sample: {sample} of complex: {complex_name}\")\n",
    "            iptm = round(float(summary_data['iptm']), 4)\n",
    "            ranking_score = round(float(summary_data['ranking_score']), 4)\n",
    "\n",
    "            structure_pred = mmcifparser.get_structure('pred', cif_path)\n",
    "            try:\n",
    "                chain_L_pred = structure_pred[0]['B']\n",
    "            except KeyError:\n",
    "                raise FileNotFoundError(f\"Required chain not found in predicted structure for sample: {sample} of complex: {complex_name}\")\n",
    "\n",
    "            align_chain_ref = None\n",
    "            for ch in structure_ref[0]:\n",
    "                if ch.id != 'B':\n",
    "                    align_chain_ref = ch\n",
    "                    break\n",
    "            if align_chain_ref is None:\n",
    "                continue\n",
    "\n",
    "            align_chain_pred = None\n",
    "            for ch in structure_pred[0]:\n",
    "                if ch.id != chain_L_pred.id:\n",
    "                    align_chain_pred = ch\n",
    "                    break\n",
    "            if align_chain_pred is None:\n",
    "                continue\n",
    "\n",
    "\n",
    "            # 将蛋白链对齐\n",
    "            align_ref_atoms = [atom for atom in align_chain_ref.get_atoms() if atom.get_id() in ['N', 'CA', 'C', 'O']]\n",
    "            align_pred_atoms = [atom for atom in align_chain_pred.get_atoms() if atom.get_id() in ['N', 'CA', 'C', 'O']]\n",
    "            if len(align_ref_atoms) == 0 or len(align_pred_atoms) == 0:\n",
    "                raise ValueError(f\"No valid atoms for alignment in sample: {sample} of complex: {complex_name}\")\n",
    "            \n",
    "            if len(align_ref_atoms) != len(align_pred_atoms):\n",
    "                raise ValueError(f\"Number of atoms for alignment do not match in sample: {sample} of complex: {complex_name}\")\n",
    "\n",
    "            sup = Superimposer()\n",
    "            try:\n",
    "                sup.set_atoms(align_ref_atoms, align_pred_atoms)\n",
    "            except Exception:\n",
    "                raise ValueError(f\"Error occurred while setting atoms for alignment in sample: {sample} of complex: {complex_name}\")\n",
    "            rot, tran = sup.rotran\n",
    "\n",
    "\n",
    "            # 计算蛋白链对齐后，多肽的骨架RMSD\n",
    "            ref_L_atoms = [atom for atom in chain_L_ref.get_atoms() if atom.get_id() in ['N', 'CA', 'C', 'O']]\n",
    "            pred_L_atoms = [atom for atom in chain_L_pred.get_atoms() if atom.get_id() in ['N', 'CA', 'C', 'O']]\n",
    "            if len(ref_L_atoms) == 0 or len(pred_L_atoms) == 0:\n",
    "                raise ValueError(f\"No valid atoms for alignment in sample: {sample} of complex: {complex_name}\")\n",
    "            if len(ref_L_atoms) != len(pred_L_atoms):\n",
    "                raise ValueError(f\"Number of atoms for alignment do not match in sample: {sample} of complex: {complex_name}\")\n",
    "\n",
    "            ref_coords = np.array([a.get_coord() for a in ref_L_atoms], dtype=float)\n",
    "            pred_coords = np.array([a.get_coord() for a in pred_L_atoms], dtype=float)\n",
    "            pred_coords_aligned = pred_coords @ rot + tran\n",
    "\n",
    "            diffs = ref_coords - pred_coords_aligned\n",
    "            scRMSD = round(float(np.sqrt(np.mean(np.sum(diffs**2, axis=1)))), 4)\n",
    "\n",
    "            rows.append(\n",
    "                (\n",
    "                    complex_name,\n",
    "                    seed,\n",
    "                    sample_id,\n",
    "                    pep_plddt,\n",
    "                    iptm,\n",
    "                    ranking_score,\n",
    "                    scRMSD,\n",
    "                )\n",
    "            )\n",
    "\n",
    "result = pd.DataFrame(\n",
    "    rows,\n",
    "    columns=['complex', 'seed', 'id', 'pep_plddt', 'iptm', 'ranking_score', 'scRMSD']\n",
    ")\n",
    "result.to_csv(f\"/home/junjiechen/1_work/250401-Dpepalign/Benchmark/Rosetta/interface/AF3/predict/metrices/metrices_summary.csv\", index=False)\n",
    "\n",
    "        # result_filtered = result[result['scRMSD'] <= 2.5].reset_index(drop=True)\n",
    "        # result_filtered.to_csv(f\"/home/junjiechen/1_work/250401-Dpepalign/Benchmark/Rosetta/interface/Dock/4_GLM/generalization/af3/summary/{complex_name}_metrics_filtered_scRMSD_le25.csv\", index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "bd9b6a13",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 将所有summary文件合并成一个总的summary文件，增加一列label列，表示是否满足scRMSD<2.5Å，pep_pLDDT>=70，ipTM>=0.7,满足这标注为1，不满足为0\n",
    "summary_dir = \"/home/junjiechen/1_work/250401-Dpepalign/Benchmark/Rosetta/interface/Dock/4_GLM/validation/generalization/af3/outputs-original/summary\"\n",
    "summary_files = [f for f in os.listdir(summary_dir) if f.endswith('_metrics_summary.csv')]\n",
    "all_rows = []\n",
    "for summary_file in summary_files:\n",
    "    summary_path = os.path.join(summary_dir, summary_file)\n",
    "    df = pd.read_csv(summary_path)\n",
    "    for _, row in df.iterrows():\n",
    "        label = 1 if (row['scRMSD'] < 2.5 and row['pep_plddt'] >= 70 and row['iptm'] >= 0.7) else 0\n",
    "        target = df['complex'][0].split(\"_\")[0]\n",
    "        all_rows.append(\n",
    "            (\n",
    "                row['complex'],\n",
    "                row['seed'],\n",
    "                row['id'],\n",
    "                row['pep_plddt'],\n",
    "                row['iptm'],\n",
    "                row['ranking_score'],\n",
    "                row['scRMSD'],\n",
    "                label,\n",
    "                target\n",
    "            )\n",
    "        )\n",
    "final_result = pd.DataFrame(\n",
    "    all_rows,\n",
    "    columns=['complex', 'seed', 'id', 'pep_plddt', 'iptm', 'ranking_score', 'scRMSD', 'label', 'target']\n",
    ")\n",
    "final_result = final_result.sort_values(by=['complex', 'seed', 'id']).reset_index(drop=True)\n",
    "final_result.to_csv(os.path.join(summary_dir, \"all_complexes_metrics_summary.csv\"), index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "319b1376",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(len(final_result[final_result['label'] == 1]))\n",
    "print(len(final_result[final_result['label'] == 0]))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3cdeb7c5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 分析每个complex的label分布情况\n",
    "for complex_name, group in final_result.groupby('target'):\n",
    "    num_positive = len(group[group['label'] == 1])\n",
    "    num_negative = len(group[group['label'] == 0])\n",
    "    print(f\"target: {complex_name}, Positive samples: {num_positive}, Negative samples: {num_negative}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6499e6e4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 每个 target 抽 20 个样本：尽量满足正负 1:1，且样本在 complex 中分散\n",
    "rng = np.random.default_rng(42)\n",
    "target_sample_size = 20\n",
    "balanced_rows = []\n",
    "\n",
    "def sample_distributed(df, n, rng):\n",
    "    if n <= 0 or df.empty:\n",
    "        return df.iloc[0:0].copy()\n",
    "\n",
    "    complex_to_indices = {\n",
    "        complex_name: rng.permutation(sub_df.index.to_numpy()).tolist()\n",
    "        for complex_name, sub_df in df.groupby('complex')\n",
    "    }\n",
    "\n",
    "    active_complexes = list(complex_to_indices.keys())\n",
    "    rng.shuffle(active_complexes)\n",
    "\n",
    "    selected_indices = []\n",
    "    cursor = 0\n",
    "    while len(selected_indices) < n and active_complexes:\n",
    "        complex_name = active_complexes[cursor % len(active_complexes)]\n",
    "        index_pool = complex_to_indices[complex_name]\n",
    "\n",
    "        if index_pool:\n",
    "            selected_indices.append(index_pool.pop())\n",
    "            cursor += 1\n",
    "        else:\n",
    "            active_complexes.remove(complex_name)\n",
    "            if active_complexes:\n",
    "                cursor = cursor % len(active_complexes)\n",
    "\n",
    "    return df.loc[selected_indices].copy()\n",
    "\n",
    "for target, group in final_result.groupby('target'):\n",
    "    # 目标抽样数不超过当前 target 可用总量\n",
    "    target_n = min(target_sample_size, len(group))\n",
    "\n",
    "    pos_pool = group[group['label'] == 1]\n",
    "    neg_pool = group[group['label'] == 0]\n",
    "\n",
    "    # 先尽量做到 1:1（优先 10 正 + 10 负）\n",
    "    base_pairs = min(target_n // 2, len(pos_pool), len(neg_pool))\n",
    "    n_pos = base_pairs\n",
    "    n_neg = base_pairs\n",
    "\n",
    "    # 若还未到 target_n，用剩余可用样本补齐（保持尽可能接近平衡）\n",
    "    remaining = target_n - (n_pos + n_neg)\n",
    "    pos_left = len(pos_pool) - n_pos\n",
    "    neg_left = len(neg_pool) - n_neg\n",
    "\n",
    "    while remaining > 0 and (pos_left > 0 or neg_left > 0):\n",
    "        if pos_left > neg_left:\n",
    "            n_pos += 1\n",
    "            pos_left -= 1\n",
    "        elif neg_left > pos_left:\n",
    "            n_neg += 1\n",
    "            neg_left -= 1\n",
    "        else:\n",
    "            if pos_left > 0 and neg_left > 0:\n",
    "                if rng.random() < 0.5:\n",
    "                    n_pos += 1\n",
    "                    pos_left -= 1\n",
    "                else:\n",
    "                    n_neg += 1\n",
    "                    neg_left -= 1\n",
    "            elif pos_left > 0:\n",
    "                n_pos += 1\n",
    "                pos_left -= 1\n",
    "            elif neg_left > 0:\n",
    "                n_neg += 1\n",
    "                neg_left -= 1\n",
    "        remaining -= 1\n",
    "\n",
    "    selected_pos = sample_distributed(pos_pool, n_pos, rng)\n",
    "    selected_neg = sample_distributed(neg_pool, n_neg, rng)\n",
    "\n",
    "    target_selected = pd.concat([selected_pos, selected_neg], ignore_index=False)\n",
    "    target_selected = target_selected.sample(\n",
    "        frac=1,\n",
    "        random_state=int(rng.integers(1, 2**31 - 1))\n",
    "    ).reset_index(drop=True)\n",
    "\n",
    "    balanced_rows.append(target_selected)\n",
    "\n",
    "balanced_result = (\n",
    "    pd.concat(balanced_rows, ignore_index=True)\n",
    "    if balanced_rows\n",
    "    else pd.DataFrame(columns=final_result.columns)\n",
    ")\n",
    "\n",
    "# 仅打散顺序，不固定 seed/id 组合\n",
    "balanced_result = balanced_result.sample(\n",
    "    frac=1,\n",
    "    random_state=int(rng.integers(1, 2**31 - 1))\n",
    ").reset_index(drop=True)\n",
    "\n",
    "sorted_balanced_result = balanced_result.sort_values(by=['target', 'complex', 'seed', 'id']).reset_index(drop=True)\n",
    "sorted_balanced_result.to_csv(os.path.join(summary_dir, \"balanced_all_complexes_metrics_summary.csv\"), index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0df70298",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 检查正负样本数目，以及每个target的分布情况\n",
    "print(\"Balanced dataset label distribution:\")\n",
    "print(sorted_balanced_result['label'].value_counts())\n",
    "for complex_name, group in sorted_balanced_result.groupby('target'):\n",
    "    num_positive = len(group[group['label'] == 1])\n",
    "    num_negative = len(group[group['label'] == 0])\n",
    "    print(f\"target: {complex_name}, Positive samples: {num_positive}, Negative samples: {num_negative}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "976f49fc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 将对应的cif文件转成pdb，复制到一个新的目录中，重命名文件为 {complex}_seed-{seed}_sample-{id}_label-{label}.pdb\n",
    "from Bio.PDB import FastMMCIFParser, PDBIO\n",
    "\n",
    "parser = FastMMCIFParser()\n",
    "io = PDBIO()\n",
    "for _, row in sorted_balanced_result.iterrows():\n",
    "    complex_name = row['complex']\n",
    "    seed = row['seed']\n",
    "    sample_id = row['id']\n",
    "    label = row['label']\n",
    "    target = row['target']\n",
    "\n",
    "    cif_dir = f'seed-{seed}_sample-{sample_id}'\n",
    "    cif_filename = f\"{target}.pdb_seed-{seed}_sample-{sample_id}_model.cif\"\n",
    "    cif_path = os.path.join(\"/home/junjiechen/1_work/250401-Dpepalign/Benchmark/Rosetta/interface/Dock/4_GLM/generalization/af3/outputs\", complex_name, cif_dir, cif_filename)\n",
    "\n",
    "    if not os.path.exists(cif_path):\n",
    "        print(f\"CIF file not found: {cif_path}\")\n",
    "        continue\n",
    "\n",
    "    pdb_filename = f\"{complex_name}_seed-{seed}_sample-{sample_id}_label-{label}.pdb\"\n",
    "    pdb_output_path = os.path.join(\"/home/junjiechen/1_work/250401-Dpepalign/Benchmark/Rosetta/interface/Dock/4_GLM/generalization/rosetta/inputs\", pdb_filename)\n",
    "\n",
    "    os.makedirs(os.path.dirname(pdb_output_path), exist_ok=True)\n",
    "\n",
    "    try:\n",
    "        structure = parser.get_structure(\"structure\", cif_path)\n",
    "        io.set_structure(structure)\n",
    "        io.save(pdb_output_path)\n",
    "        print(f\"Converted {cif_path} to {pdb_output_path}\")\n",
    "    except Exception as e:\n",
    "        print(f\"Error converting {cif_path}: {e}\")"
   ]
  }
 ],
